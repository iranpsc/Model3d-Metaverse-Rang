            "Wheel_FL",
            "Wheel_FR",
            "Wheel_RL",
            "Wheel_RR",
            "Door_Front",
            "Door_Mid",
            "Seat_Driver"
          ]
        },
        "motorcycle_2w": {
          "title_fa": "موتور دوچرخ",
          "required_nodes": [
            "Body",
            "Wheel_F",
            "Wheel_R",
            "Handlebar",
            "Seat_Driver"
          ]
        },
        "atv_4w": {
