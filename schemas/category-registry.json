{
  "schema_version": "5.0.0",
  "spec_ref": "MR-3D-EXEC-V5.0",
  "core_rules": {
    "valid_root_directories": [
      "01-investors-assets",
      "02-companies-holdings",
      "03-citizen-creations",
      "04-metarang-core-assets",
      "05-forked-developments"
    ],
    "dimensional_tolerance_pct": 0.02,
    "color_delta_e_threshold": 24.0,
    "max_package_size_mb": 100.0,
    "min_render_images": 2,
    "zero_override_branch": "main"
  },
  "categories": {
    "building": {
      "id": "building",
      "label": "type:building",
      "title_en": "Building, Architecture & Structures",
      "title_fa": "سازه، معماری و ساختمان",
      "issue_template": ".github/ISSUE_TEMPLATE/01-building.yml",
      "validator_module": "scripts/validators/building.py",
      "defaults": {
        "ground_aligned": true,
        "require_uv": true
      }
    },
    "avatar": {
      "id": "avatar",
      "label": "type:avatar",
      "title_en": "Avatar & Humanoid Characters (Ready Player Me)",
      "title_fa": "آواتار و کاراکتر انسانی (Ready Player Me)",
      "issue_template": ".github/ISSUE_TEMPLATE/02-avatar.yml",
      "validator_module": "scripts/validators/avatar.py",
      "standards": {
        "rig_standard": "ReadyPlayerMe_Humanoid",
        "blendshapes_mandatory": true,
        "required_bones": [
          "Hips",
          "Spine",
          "Spine1",
          "Spine2",
          "Neck",
          "Head",
          "LeftShoulder",
          "LeftArm",
          "LeftForeArm",
          "LeftHand",
          "RightShoulder",
          "RightArm",
          "RightForeArm",
          "RightHand",
          "LeftUpLeg",
          "LeftLeg",
          "LeftFoot",
          "RightUpLeg",
          "RightLeg",
          "RightFoot"
        ],
        "required_visemes_sample": [
          "viseme_sil",
          "viseme_aa",
          "viseme_O"
        ],
        "max_bones_default": 75
      }
    },
    "vehicle": {
      "id": "vehicle",
      "label": "type:vehicle",
      "title_en": "Vehicles (Land, Air & Sea - Unity 6)",
      "title_fa": "وسایل نقلیه (زمینی، هوایی و دریایی - Unity 6)",
      "issue_template": ".github/ISSUE_TEMPLATE/03-vehicle.yml",
      "validator_module": "scripts/validators/vehicle.py",
      "subtypes": {
        "car": {
          "title_fa": "خودرو سواری",
          "required_nodes": [
            "Body",
            "Wheel_FL",
            "Wheel_FR",
            "Wheel_RL",
            "Wheel_RR",
            "Door_FL",
            "Door_FR",
            "SteeringWheel",
            "Seat_Driver"
