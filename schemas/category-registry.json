            "Propeller",
            "LandingGear_F",
            "LandingGear_L",
            "LandingGear_R",
            "Aileron_L",
            "Aileron_R",
            "Rudder",
            "Seat_Pilot"
          ]
        },
        "jetpack": {
          "title_fa": "جت‌پک",
          "required_nodes": [
            "Body",
            "Thruster_L",
            "Thruster_R",
            "Mount_Spine"
